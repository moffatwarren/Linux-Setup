# Catppuccin Mocha for btop -- the palette in quickshell/Theme.qml.
#
# btop ships 41 themes in /usr/share/btop/themes and none of them is
# Catppuccin, so this is a user theme: btop also reads
# ~/.config/btop/themes, which is where deploy_configs puts it.
# The name here has to match `color_theme` in ../btop.conf.

# Main background. Empty would use the terminal's, but kitty already paints
# base and btop.conf sets theme_background = true, so state it.
theme[main_bg]="#1e1e2e"

# Main text color
theme[main_fg]="#cdd6f4"

# Title color for boxes
theme[title]="#cdd6f4"

# Highlight color for keyboard shortcuts
theme[hi_fg]="#89b4fa"

# Background color of selected item in processes box
theme[selected_bg]="#45475a"

# Foreground color of selected item in processes box
theme[selected_fg]="#89b4fa"

# Color of inactive/disabled text
theme[inactive_fg]="#7f849c"

# Color of text appearing on top of graphs, i.e uptime and current network
# graph scaling
theme[graph_text]="#f5e0dc"

# Background color of the percentage meters
theme[meter_bg]="#45475a"

# Misc colors for processes box including mini cpu graphs, details memory
# graph and details status text
theme[proc_misc]="#f5e0dc"

# Box outlines. One accent per box, so the four panels stay tellable apart at
# a glance the way the noctalia theme's four identical greys did not.
theme[cpu_box]="#cba6f7"   # mauve
theme[mem_box]="#a6e3a1"   # green
theme[net_box]="#eba0ac"   # maroon
theme[proc_box]="#89b4fa"  # blue

# Box divider line and small boxes line color
theme[div_line]="#6c7086"

# Temperature graph (green -> yellow -> red)
theme[temp_start]="#a6e3a1"
theme[temp_mid]="#f9e2af"
theme[temp_end]="#f38ba8"

# CPU graph (teal -> sapphire -> lavender)
theme[cpu_start]="#94e2d5"
theme[cpu_mid]="#74c7ec"
theme[cpu_end]="#b4befe"

# Mem/Disk free meter (mauve -> lavender -> blue)
theme[free_start]="#cba6f7"
theme[free_mid]="#b4befe"
theme[free_end]="#89b4fa"

# Mem/Disk cached meter (sapphire -> blue -> lavender)
theme[cached_start]="#74c7ec"
theme[cached_mid]="#89b4fa"
theme[cached_end]="#b4befe"

# Mem/Disk available meter (peach -> maroon -> red)
theme[available_start]="#fab387"
theme[available_mid]="#eba0ac"
theme[available_end]="#f38ba8"

# Mem/Disk used meter (green -> teal -> sky)
theme[used_start]="#a6e3a1"
theme[used_mid]="#94e2d5"
theme[used_end]="#89dceb"

# Download graph (peach -> maroon -> red)
theme[download_start]="#fab387"
theme[download_mid]="#eba0ac"
theme[download_end]="#f38ba8"

# Upload graph (green -> teal -> sky)
theme[upload_start]="#a6e3a1"
theme[upload_mid]="#94e2d5"
theme[upload_end]="#89dceb"

# Process box gradient for threads, mem and cpu usage (sapphire -> mauve)
theme[process_start]="#74c7ec"
theme[process_mid]="#b4befe"
theme[process_end]="#cba6f7"

# Process box banners and the "following" row. Only 4 of btop's 41 shipped
# themes set these, so they are easy to miss -- but an unset key falls back to
# btop's built-in *default* theme rather than to anything above, which is how a
# stock blue-on-white banner ends up on a Mocha background. Running btop with
# log_level = "DEBUG" names every key a theme leaves out.
#
# The foregrounds are crust rather than a light colour: Mocha's accents are
# pale pastels, so a banner wants dark text on them -- the same pairing kitty
# uses for its active tab (#11111b on mauve).
theme[proc_pause_bg]="#f38ba8"   # red -- paused
theme[proc_follow_bg]="#89b4fa"  # blue -- following
theme[proc_banner_bg]="#cba6f7"  # mauve
theme[proc_banner_fg]="#11111b"
theme[followed_bg]="#89b4fa"
theme[followed_fg]="#11111b"
