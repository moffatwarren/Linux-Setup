[Default]
save_dir=$HOME/Pictures/Screenshots
save_filename_format=swappy-%Y%m%d-%H%M%S.png
show_panel=false
line_size=5
text_size=20
text_font=sans-serif
paint_mode=brush
early_exit=false
fill_shape=false
auto_save=false
# Annotation pen. Catppuccin Mocha red (#f38ba8) -- swappy takes a GdkRGBA
# string, so the channels are 0-255 and only the alpha is 0-1. Red rather
# than an accent like mauve because this is drawn *on top of* screenshots of
# this desktop, which is largely mauve and lavender already.
custom_color=rgba(243,139,168,1)
transparent=false
transparency=50
