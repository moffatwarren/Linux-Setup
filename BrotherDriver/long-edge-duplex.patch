+// The printer always flips the sheet on its short edge, so on a long-edge
+// job the back of every sheet has to arrive upside down. pdftopdf does that
+// rotation, but only when the job carries the IPP "sides" attribute; a job
+// that asks for duplex through the PPD's Duplex option alone (Chrome does)
+// reaches this filter unrotated. For those the filter rotates the page
+// itself: it is buffered, then replayed bottom line first, each line mirrored.
+std::vector<std::vector<uint8_t>> rotated_page;
+size_t rotated_pos;
+
+bool next_rotated_line(std::vector<uint8_t> &buf) {
+  if (interrupted || rotated_pos >= rotated_page.size()) {
+    return false;
+  }
+  buf = rotated_page[rotated_pos++];
+  return true;
+}
+
+void read_rotated_page(const cups_page_header2_t &header) {
+  const unsigned width = header.cupsWidth;
+  const size_t linesize = header.cupsBytesPerLine;
+  rotated_page.clear();
+  rotated_pos = 0;
+
+  std::vector<uint8_t> line(linesize);
+  for (unsigned i = 0; i < header.cupsHeight && next_line(line); ++i) {
+    // Mirror the pixels within the page width; padding bits past it stay 0.
+    std::vector<uint8_t> mirrored(linesize, 0);
+    for (unsigned x = 0; x < width; ++x) {
+      unsigned src = width - 1 - x;
+      if (line[src / 8] & (0x80 >> (src % 8))) {
+        mirrored[x / 8] |= 0x80 >> (x % 8);
+      }
+    }
+    rotated_page.push_back(std::move(mirrored));
+  }
+  std::reverse(rotated_page.begin(), rotated_page.end());
+}
+
+bool pdftopdf_rotated(const char *job_options) {
+  cups_option_t *options = nullptr;
+  int num_options = cupsParseOptions(job_options, 0, &options);
+  const char *sides = cupsGetOption("sides", num_options, options);
+  bool result = sides && strcmp(sides, "two-sided-long-edge") == 0;
+  cupsFreeOptions(num_options, options);
+  return result;
+}
